# General Settings
DJANGO_ENV=production
DEBUG=False
DJANGO_SECRET_KEY=your_production_secret_key_here
DJANGO_ALLOWED_HOSTS=your_domain.com,www.your_domain.com,your_server_ip

# Database Settings
DB_ENGINE=postgres

# PostgreSQL Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=findlebot_db
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
